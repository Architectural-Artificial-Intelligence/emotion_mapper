{
  "name": "emotion-mapper",
  "version": "1.0.0",
  "description": "Emotion Mapper prototype — Node/Express server wrapping the 360-PANAS pipeline and heatmap.py port",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "server": "node server/app.js",
    "test": "node server/heatmap/dxf.test.js",
    "tauri": "tauri",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs && node scripts/fetch-node-runtime.mjs",
