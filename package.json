    "tauri:build": "npm run prepare:sidecar && tauri build"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "dxf-parser": "^1.1.2",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "license": "MIT"
}
